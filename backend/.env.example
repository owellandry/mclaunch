MCLAUNCH_API_PORT=8787
MCLAUNCH_API_HOST=127.0.0.1
MCLAUNCH_API_BASE_URL=http://127.0.0.1:8787
MCLAUNCH_API_JWT_SECRET=cambia-esto-para-produccion

# Discord OAuth (application) + Bot (for presence/online status)
MCLAUNCH_DISCORD_CLIENT_ID=
MCLAUNCH_DISCORD_CLIENT_SECRET=
MCLAUNCH_DISCORD_BOT_TOKEN=
MCLAUNCH_DISCORD_REDIRECT_URI=http://127.0.0.1:8787/api/v1/discord/oauth/callback
# Default: identify. If Discord approved relationships.read, set: identify relationships.read
MCLAUNCH_DISCORD_SCOPES=identify
# Optional: guild where the bot tracks presence for the launcher community
MCLAUNCH_DISCORD_GUILD_ID=

MCLAUNCH_MICROSOFT_CLIENT_ID=
MCLAUNCH_MICROSOFT_CLIENT_SECRET=
MCLAUNCH_MICROSOFT_REDIRECT_URI=http://127.0.0.1:8787/api/v1/login/callback
MCLAUNCH_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/mclaunch
MCLAUNCH_REDIS_URL=redis://127.0.0.1:6379
MCLAUNCH_DOWNLOADS_DIR=dist
MCLAUNCH_INSTALLER_DOWNLOADS_DIR=react-installer/dist-installer
MCLAUNCH_HOTUPDATE_PACKAGES_DIR=build/hotupdates
